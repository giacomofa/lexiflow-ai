OPENAI_API_KEY=your_openai_api_key_here

# Opcional: senha do admin padrão criado na primeira execução (usuário "admin").
# Se não definida, usa o fallback inseguro "admin123" — troque antes de publicar a app.
LEXIFLOW_DEFAULT_ADMIN_PASSWORD=escolha_uma_senha_forte

# Opcional: chave de criptografia do texto dos documentos salvos (Fernet).
# Se não definida, uma chave é gerada automaticamente em data/.encryption_key
# na primeira execução — recomendado definir aqui em produção (ex.: secrets
# do Streamlit Community Cloud), especialmente com filesystem efêmero, já
# que perder a chave torna os documentos já salvos permanentemente ilegíveis.
# Gere uma com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LEXIFLOW_ENCRYPTION_KEY=